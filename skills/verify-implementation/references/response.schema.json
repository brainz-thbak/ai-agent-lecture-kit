{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "구현·회귀 검증 응답",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "task_id", "requirements_file", "summary", "results", "issues"],
  "properties": {
    "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "task_id": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
    "requirements_file": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
    "summary": { "$ref": "#/$defs/text" },
    "results": { "type": "array", "items": { "$ref": "#/$defs/result" } },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "properties": { "task_id": { "type": "null" } } },
          { "properties": { "requirements_file": { "type": "null" } } }
        ]
      },
      "then": { "properties": { "status": { "const": "BLOCKED" }, "results": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "PASS" } } },
      "then": {
        "properties": {
          "results": {
            "contains": { "properties": { "required": { "const": true }, "status": { "const": "PASS" } } },
            "not": {
              "contains": {
                "anyOf": [
                  { "properties": { "status": { "const": "FAIL" } } },
                  { "properties": { "required": { "const": true }, "status": { "const": "UNVERIFIED" } } }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAIL" } } },
      "then": { "properties": { "results": { "contains": { "properties": { "status": { "const": "FAIL" } } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "BLOCKED" } } },
      "then": {
        "properties": {
          "results": { "not": { "contains": { "properties": { "status": { "const": "FAIL" } } } } },
          "issues": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "textList": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "related_ids", "required", "status", "procedure", "expected", "actual", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["REQUIREMENT", "REGRESSION"] },
        "related_ids": { "$ref": "#/$defs/textList", "minItems": 1 },
        "required": { "type": "boolean" },
        "status": { "enum": ["PASS", "FAIL", "UNVERIFIED"] },
        "procedure": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "expected": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "actual": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "evidence": { "$ref": "#/$defs/textList" }
      },
      "if": { "properties": { "status": { "enum": ["PASS", "FAIL"] } } },
      "then": {
        "properties": {
          "procedure": { "type": "string" },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "evidence": { "minItems": 1 }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "related_ids", "reason", "next_action"],
      "properties": {
        "kind": { "enum": ["INPUT", "REQUIREMENT", "TEST", "ENVIRONMENT"] },
        "related_ids": { "$ref": "#/$defs/textList" },
        "reason": { "$ref": "#/$defs/text" },
        "next_action": { "$ref": "#/$defs/text" }
      }
    }
  }
}
